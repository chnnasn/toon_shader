{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e58856767d2454f9a90fcd640cac2edf",
    "m_Title": "How to Read / 阅读顺序",
    "m_Content": "按 01→07 阅读可见表面数据流：纹理采样、Ramp、遮罩、高光、头发、丝袜、脸部 SDF 与最终合成。Stencil、Outline、Reflection、PreDepth 属于固定管线和多 Pass 行为，位于 WuchangCharacter.shader + WuchangCharacterCommon.hlsl + Renderer Feature，不伪装成额外 Shader Graph。",
    "m_TextSize": 0,
    "m_Theme": 1,
    "m_Position": {
        "serializedVersion": "2",
